# FastAPI
ENVIRONMENT=development
DEBUG=true
APP_NAME=Sovereign AI Workbench
APP_VERSION=1.0.0

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/sih_sovereign

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL_MAIN=llama3.2:1b
OLLAMA_MODEL_CODE=llama3.2:3b
OLLAMA_MODEL_VISION=llava:7b
OLLAMA_MODEL_EMBEDDINGS=nomic-embed-text

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents

# Storage
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
